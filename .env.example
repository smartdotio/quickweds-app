# Leave Supabase vars empty to run in DEMO MODE (in-memory sample data, simulated payments).

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (EU region recommended) — Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack — Settings → API Keys & Webhooks. Webhook URL: {SITE}/api/paystack/webhook
PAYSTACK_SECRET_KEY=

# Cal.com — private event link (e.g. "osagieco/strategy-session-x7k2"). Webhook URL: {SITE}/api/cal/webhook
NEXT_PUBLIC_CAL_LINK=
CAL_WEBHOOK_SECRET=

# Resend — verified sending domain (SPF, DKIM, DMARC)
RESEND_API_KEY=
EMAIL_FROM="Osagie & Co. <hello@mail.yourdomain.com>"
STAFF_NOTIFY_EMAIL=

# Random string; Vercel Cron sends it as a Bearer token to /api/cron/retention
CRON_SECRET=
